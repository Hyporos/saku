# Mongoose 7 pins whatwg-url@11, which still requires Node's deprecated `punycode`, so every script
# that touches the database opened with a DEP0040 warning that nothing in this repo can act on. This
# silences that one code only — discord.js deprecations and anything else Node warns about still show,
# which is the point. It goes when mongoose is upgraded to 8.
node-options=--disable-warning=DEP0040
